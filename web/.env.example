# The Anthropic API key is SERVER-SIDE ONLY. It is never bundled into the
# client and must never be committed. Set it on Vercel:
#   vercel env add ANTHROPIC_API_KEY production
# For local full-stack dev (`vercel dev`), pull it into .env.local:
#   vercel env pull .env.local
#
# Optional: override the primary chat model (server-side).
# CLASSY_MODEL=claude-opus-5
