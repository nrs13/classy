# .env.local
# CLASSY_MAX_SPEND_USD=8
#
# Vercel: ANTHROPIC_API_KEY
# CLASSY_MODEL=claude-opus-5
# CLASSY_EFFORT=low
#
# Deployment. Copy these into the host environment. Values stay empty here.
# CHAT_MODE is off, canned, or live. A missing or any other value is off.
CHAT_MODE=
# gemini or anthropic. Empty uses gemini.
CHAT_PROVIDER=
# Empty uses gemini-3.5-flash-lite.
CHAT_MODEL=
# Server only. Separate from GEMINI_API_KEY. Never put this in a URL or the client bundle.
GEMINI_CHAT_API_KEY=
# Empty uses 400, which sits under the reported free daily limit for gemini-3.5-flash-lite.
CLASSY_CHAT_DAILY_CAP=
# Postgres catalog. Empty off Vercel uses the local database. On Vercel an empty value leaves the catalog unconfigured.
DATABASE_URL=
# Media. Empty CLASSY_BUCKET serves files from disk. Empty CLASSY_OBJECT_ROOT uses catalog/objects.
# Set CLASSY_MEDIA_SECRET in production; empty uses the local development default.
CLASSY_BUCKET=
CLASSY_OBJECT_ROOT=
CLASSY_MEDIA_SECRET=
# CLASSY_QUOTE_FLOOR=0.5
# VIRALITY_ROOT=
#
# Search embeddings (Voyage by default; pack and search must use the same profile)
# VOYAGE_API_KEY=
# CLASSY_EMBED_PROVIDER=voyage
# CLASSY_EMBED_DOC_MODEL=voyage-4-large
# CLASSY_EMBED_QUERY_MODEL=voyage-4-lite
# CLASSY_EMBED_DIM=1024
# CLASSY_EMBED_TIMEOUT_MS=2500
# GEMINI_API_KEY=
#
# Optional rerank (off unless set to gemini)
# CLASSY_RERANK=
# CLASSY_RERANK_MODEL=
# CLASSY_RERANK_TIMEOUT_MS=1500
#
# Logs: json (default) or off
# CLASSY_LOG=
